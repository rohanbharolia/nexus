# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Set AI_PROVIDER to one of the options below. Leave as "deterministic-fallback"
# to run without any AI key (rule-based mode).
#
# AI_PROVIDER options:
#   deterministic-fallback  — no AI key needed, rule-based responses (default)
#   openai                  — OpenAI GPT-4o, GPT-4o-mini, etc.
#   gemini                  — Google Gemini 1.5 Flash / Pro
#   openrouter              — Access 200+ models via one API key
#   deepseek                — DeepSeek Chat (very cheap, strong reasoning)
#   groq                    — Ultra-fast Llama 3.1 inference
#   ollama                  — Local models (no API key required)

AI_PROVIDER="deterministic-fallback"

# ── Option 1: OpenAI ──────────────────────────────────────────────────────────
# AI_PROVIDER="openai"
# AI_API_KEY="sk-..."
# AI_MODEL="gpt-4o-mini"                    # or gpt-4o, gpt-4-turbo
# AI_ENDPOINT=""                            # leave blank for OpenAI default

# ── Option 2: Google Gemini ───────────────────────────────────────────────────
# Get key free at: https://aistudio.google.com/app/apikey
# AI_PROVIDER="gemini"
# AI_API_KEY="AIza..."
# AI_MODEL="gemini-1.5-flash"               # or gemini-1.5-pro, gemini-2.0-flash-exp

# ── Option 3: OpenRouter (access 200+ models with one key) ───────────────────
# Get key at: https://openrouter.ai/keys
# AI_PROVIDER="openrouter"
# AI_API_KEY="sk-or-..."
# AI_MODEL="openai/gpt-4o-mini"             # or anthropic/claude-3-haiku, mistralai/mistral-7b-instruct

# ── Option 4: DeepSeek (very affordable) ─────────────────────────────────────
# Get key at: https://platform.deepseek.com/
# AI_PROVIDER="deepseek"
# AI_API_KEY="sk-..."
# AI_MODEL="deepseek-chat"

# ── Option 5: Groq (fast inference) ──────────────────────────────────────────
# Get key at: https://console.groq.com/
# AI_PROVIDER="groq"
# AI_API_KEY="gsk_..."
# AI_MODEL="llama-3.1-8b-instant"           # or llama-3.1-70b-versatile

# ── Option 6: Ollama (local, free, no key needed) ────────────────────────────
# Install: https://ollama.com  then: ollama pull llama3.2
# AI_PROVIDER="ollama"
# AI_API_KEY="ollama"                       # required by the field but ignored
# AI_MODEL="llama3.2"
# AI_ENDPOINT="http://localhost:11434/v1"
